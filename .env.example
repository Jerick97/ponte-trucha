# Copia este archivo a .env.local y llena los valores, o generalo con
#   AWS_ENDPOINT_URL=http://localhost:4566 sh scripts/entorno-floci.sh
#
# Las variables VITE_* terminan en el bundle publico: aqui NUNCA va un secreto.
# El id del app client y el del User Pool son identificadores publicos.

# --- Backend (obligatorio para jugar) ---
# Base del API /v1. En local, el proxy del dev server la mapea a API Gateway.
VITE_API_BASE_URL=/api
# Endpoint de cognito-idp. En local, el proxy la mapea al User Pool emulado.
VITE_COGNITO_URL=/cognito
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_USER_POOL_ID=
# Solo AWS real: Cognito Hosted UI con Authorization Code + PKCE.
VITE_COGNITO_OAUTH_URL=
VITE_COGNITO_REDIRECT_URI=

# --- Solo para el proxy de Vite (Node); no entran al bundle ---
# Endpoint del emulador y id del HTTP API creado por Terraform.
PTK_LOCAL_AWS_ENDPOINT=http://localhost:4566
PTK_LOCAL_API_ID=

# --- Demo legado del estafador (opcional) ---
# URL de la Lambda Function URL del demo anterior. Vacia = no se usa.
VITE_LLM_ENDPOINT=

# --- Variables de despliegue (van en .env.deploy, no en .env.local) ---
# BUCKET=ponte-trucha-web
# DISTRIBUTION_ID=E123456ABCDEF
# DOMINIO=d1234abcd.cloudfront.net

# --- Producción en Vercel (se configuran en el dashboard, no en este archivo) ---
# El navegador habla siempre con el dominio de Vercel; vercel.json reenvía
# /api -> API Gateway y /cognito -> cognito-idp (por eso van rutas relativas).
# Los IDs salen de los outputs de Terraform. OJO: el redirect lleva barra final
# y debe coincidir carácter por carácter con el callback registrado en Cognito.
# VITE_API_BASE_URL=/api
# VITE_COGNITO_URL=/cognito
# VITE_COGNITO_CLIENT_ID=<app client del User Pool>
# VITE_COGNITO_USER_POOL_ID=<id del User Pool>
# VITE_COGNITO_OAUTH_URL=https://<dominio-hosted-ui>.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_REDIRECT_URI=https://ponte-trucha.vercel.app/
